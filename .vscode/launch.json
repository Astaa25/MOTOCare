{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MotoCare (Chrome - Web Preview)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome",
        "--web-hostname",
        "127.0.0.1",
        "--web-port",
        "8080",
        "--dart-define-from-file=.env"
      ]
    },
    {
      "name": "MotoCare (Android)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "android",
        "--dart-define-from-file=.env"
      ]
    }
  ]
}

