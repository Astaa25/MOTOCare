# Konfigurasi Supabase MotoCare
# Salin berkas ini menjadi .env dan isi nilainya (JANGAN COMMIT .env)
# Mode Mock: jika USE_MOCK=true, aplikasi memakai mock repository berlabel Demo/Simulasi

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
USE_MOCK=true

# Feature Flag Google Maps Platform
# Set 'true' untuk mengaktifkan Google Maps SDK, atau 'false' untuk fallback manual & url_launcher
MAPS_ENABLED=true

# CATATAN KEAMANAN KUNCI GOOGLE MAPS PLATFORM (JANGAN PERNAH MENARUH KEY NYATA DI SINI):
# 1. Kunci Android: simpan di android/local.properties (MAPS_API_KEY=AIzaSy...)
# 2. Kunci Server (Web Service): simpan di Supabase Secrets
#    Jalankan: supabase secrets set GOOGLE_MAPS_SERVER_KEY=AIzaSy...
# 3. Baca panduan lengkap di: docs/MAPS_SETUP.md
